    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        plum: {
                            DEFAULT: '#6B214B',
                            dark: '#4D1535',
                            light: '#8E3567'
                        },
                        gold: {
                            DEFAULT: '#C5A059',
                            light: '#DFC38A'
                        },
                        blush: '#FADADD',
                        champagne: '#F9F3EC',
