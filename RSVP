</head>
<body class="font-sans text-gray-800 antialiased bg-gradient-to-br from-[#FBF4F7] via-[#F9F3EC] to-[#EFE9F4] min-h-screen selection:bg-plum selection:text-white">

    <!-- Sticky Top Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gold/30 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-16">
                <a href="#home" class="font-script text-2xl sm:text-3xl text-plum hover:text-plum-light transition">
                    C &amp; A
                </a>
                <div class="flex items-center space-x-2 sm:space-x-6 text-xs sm:text-sm font-medium text-plum">
                    <a href="#details" class="px-2 py-1.5 rounded-lg hover:bg-blush/40 transition">Details</a>
                    <a href="#entourage" class="px-2 py-1.5 rounded-lg hover:bg-blush/40 transition">Sponsors</a>
                    <a href="#menu" class="px-2 py-1.5 rounded-lg hover:bg-blush/40 transition">Menu</a>
                    <a href="#rsvp" class="bg-plum text-white px-4 py-2 rounded-full shadow-sm hover:bg-plum-dark transition transform hover:-translate-y-0.5">
